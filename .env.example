# Copie para .env e substitua todos os valores de exemplo por valores exclusivos.
POSTGRES_PASSWORD=replace-with-a-unique-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@phnews.local
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters-long
NEWS_FEED_URL=https://agenciabrasil.ebc.com.br/rss/ultimasnoticias/feed.xml
NEWS_REFRESH_MINUTES=5
PORT=3000
# Habilite quando a aplicação estiver acessível exclusivamente por HTTPS.
COOKIE_SECURE=false
